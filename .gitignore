# Dependencies — the host (DeepSeek Harness) provides react / react-dom at
# runtime; everything else is installed by `pnpm install`.
node_modules/

# Build output. `pnpm run build` regenerates dist/index.mjs + dist/client.js
# (and the .map files). dist/ IS committed so the published package needs no
# build step at install time: pnpm >= 10 blocks a git dependency's prepare
# script unless the package is on the profile's allowBuilds allowlist, and the
# inlined ssh2/xterm mean dist/ loads with no node_modules at all.
dist/*.map

# Local build / probe logs
*.log
*.log.*

# Local data and scratch directories (device store, session logs, probes)
data/
data-*/
!test/fixtures/

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Secrets — never commit a filled-in token or a device password
.env
.env.*
!.env.example
