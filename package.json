{
  "name": "dsh-hillstone-cli-ops",
  "displayName": "DSH Hillstone CLI 运维",
  "description": "设备运维终端插件：右侧栏「设备运维」标签页，管理 Hillstone / StoneOS 设备（增删改查 + 搜索分页 + 端口存活探测 + SSH 终端 + 连接审计日志），并向 agent 提供 7 个 hillstone_* 运维工具。连接成功后自动切到终端页，agent 触发的连接会展开到发起它的那个会话。",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "sidebarRightTabs",
        "sidebarRight",
        "uiWorkspace"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "hillstone",
    "ssh",
    "ops",
    "terminal"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.15.6",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "playwright": "^1.61.1",
    "ssh2": "^1.15.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  }
}
