{
  "name": "dsh-hillstone-cli-ops",
  "displayName": "Hillstone 设备运维",
  "description": "Hillstone / StoneOS 设备运维插件：右侧栏「设备运维」标签页（设备管理 + SSH 终端 + 连接审计 + 执行策略），并给 agent 注册 9 个 hillstone_* 运维工具。ssh2 与 xterm 已内联进 dist，运行时零 node_modules 依赖，安装免构建（git / npm / tarball 均无需 prepare 或 allowBuilds）。",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "locale",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "sidebarRightTabs",
        "sidebarRight",
        "uiWorkspace"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "hillstone",
    "ssh",
    "ops",
    "terminal"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/terminal-regression.mjs && node test/bundle-gate.mjs && node test/locale-gate.mjs && node test/portability-gate.mjs",
    "test:locale:negctl": "node test/negctl-locale.mjs",
    "test:modal:negctl": "node test/negctl-modal-placement.mjs",
    "test:webui:negctl": "node test/negctl-web-login-viewport.mjs",
    "test:copy:negctl": "node test/negctl-m04031-copy.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.15.6",
    "esbuild": "^0.25.12",
    "ssh2": "^1.15.0",
    "typescript": "^5.6.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "optionalDependencies": {
    "playwright": "^1.61.1"
  }
}
